# ─── LLM Provider ────────────────────────────────────────────────────────────
# Options: claude | openai | gemini
LLM_PROVIDER=claude

# Model to use (examples below — pick one per provider)
# Claude:  claude-sonnet-4-6 | claude-haiku-4-5-20251001 | claude-opus-4-8
# OpenAI:  gpt-4o | gpt-4o-mini | gpt-4-turbo
# Gemini:  gemini-2.0-flash | gemini-1.5-pro | gemini-1.5-flash
LLM_MODEL=claude-sonnet-4-6

# ─── Provider API Keys ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ─── Google Sheets ────────────────────────────────────────────────────────────
# Share your sheet with the service account email below
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Paste the private key exactly as in the JSON file (including newlines as \n)
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END RSA PRIVATE KEY-----\n"
# The long ID from the Google Sheets URL
GOOGLE_SHEET_ID=your_google_sheet_id_here

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=https://www.kormoan.in,http://localhost:3000
